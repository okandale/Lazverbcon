# Omit LAZ_DATABASE to run the engine directly during development.
# LAZ_DATABASE=/absolute/path/to/artifacts/full.sqlite
# Set this to serve the built website from the Python API.
# LAZ_WEB_DIST=/absolute/path/to/apps/web/dist
# Docker Compose host port (default 8080).
# LAZ_PORT=8080
# Set to the server's LAN IP to allow access from other devices on the network.
# LAZ_BIND_ADDRESS=192.168.1.50
